{
  "name": "coily-workspace",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev:vanilla": "turbo run dev --filter=playground-vanilla...",
    "dev:nuxt": "turbo run dev --filter=playground-nuxt...",
    "deps:reinstall": "pnpm dlx rimraf --glob node_modules packages/*/node_modules pnpm-lock.yaml && pnpm install",
    "deps:upgrade": "pnpm update --recursive --latest && pnpm dedupe",
    "typecheck": "turbo run check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "check": "turbo run check && oxlint && oxfmt --check .",
    "fix": "oxlint --fix && oxfmt --write .",
    "test": "turbo run test",
    "version-packages": "changeset version && pnpm install --lockfile-only && pnpm run format"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@types/node": "^26.1.1",
    "oxfmt": "^0.58.0",
    "oxlint": "^1.73.0",
    "turbo": "^2.10.4",
    "typescript": "catalog:"
  },
  "engines": {
    "node": ">=24.10.0",
    "pnpm": ">=12"
  },
  "packageManager": "pnpm@12.18.0+sha512.9d7882d5dc82147ecfc4e062aa34834e0ad0296710a1837a1115ae012127d36b7109e321ac1598a1dd0a65597681b1e99917e12ed0d749eae91187943363beb3"
}
